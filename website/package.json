{
  "name": "audeeo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sandbox": "tsc -b && vite build --mode sandbox",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:dry": "npm run build && wrangler deploy --config wrangler.jsonc --dry-run",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@revenuecat/purchases-js": "1.60.1",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "5.5.0",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "4.131.2"
  }
}
