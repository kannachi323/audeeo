# App channel: direct (DMG), app-store, or web. Packaging validates this value.
AUDEEO_DISTRIBUTION=direct
# sandbox for payment testing; production for live purchases.
AUDEEO_BILLING_ENVIRONMENT=sandbox
RELAY_URL=https://api.audeeo.app
AUTH_REDIRECT_URL=http://localhost:1420
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public SDK keys. Apple uses the same appl_ key in sandbox and production.
REVENUECAT_APPLE_KEY=
REVENUECAT_WEB_KEY=
REVENUECAT_WEB_SANDBOX_KEY=

# Server-only credentials. Soniox handles live captions and speech.
SUPABASE_SECRET_KEY=
SONIOX_API_KEY=
# OpenAI remains necessary for summaries, questions, and Fill from screen.
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-5.6-luna
REVENUECAT_SECRET_KEY=
REVENUECAT_V2_SECRET_KEY=
REVENUECAT_PROJECT_ID=696fbac4
REVENUECAT_WEBHOOK_AUTH_KEY=

# Server-only UUID lists. Billing testers get no free or unlimited usage.
BILLING_TEST_USER_IDS=
# Dedicated review accounts only: routes production-binary billing to the sandbox.
APP_REVIEW_USER_IDS=
DEV_USER_IDS=

# Server-only Apple token revocation for account deletion.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
