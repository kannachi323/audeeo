{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audeeo-session-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false
  },
  "vars": {
    "MAX_SESSION_SECONDS": "1800",
    "CAPTION_PROVIDER": "soniox",
    "SONIOX_MODEL": "stt-rt-v5",
    "REVENUECAT_ENTITLEMENT": "audeeo_pro",
    "ALLOWED_ORIGINS": "http://localhost:1420,tauri://localhost,http://tauri.localhost,https://audeeo.app,https://www.audeeo.app"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.audeeo.app",
      "custom_domain": true
    }
  ]
}
